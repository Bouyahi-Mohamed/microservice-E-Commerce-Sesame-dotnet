{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Spring": {
    "Application": {
      "Name": "identity-service"
    },
    "Cloud": {
      "Config": {
        "Uri": "http://config-server:9999",
        "FailFast": false,
        "ValidateCertificates": false
      }
    }
  },
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://eureka-server:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ValidateCertificates": false
    },
    "Instance": {
      "PreferIpAddress": true
    }
  }
}